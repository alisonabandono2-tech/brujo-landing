# Public identifier, served by tracking-config; no placeholder is sent to Meta.
META_PIXEL_ID=
# Secrets: configure with Functions scope in Netlify, never commit their values.
META_CAPI_TOKEN=
ONEWIN_POSTBACK_SECRET=
TRACKING_REPORT_TOKEN=
# Optional. Match a supported Meta Graph API version.
META_GRAPH_VERSION=v25.0
# Set only in Deploy Preview context for Meta Test Events verification.
META_TEST_EVENT_CODE=
